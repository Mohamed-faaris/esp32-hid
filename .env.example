# One shared environment file. Copy to .env and never commit real credentials.
ESP32_API_URL=http://192.168.4.1
ESP32_API_SECRET=replace-with-a-long-random-device-secret
ESP32_API_TIMEOUT_MS=8000
ESP32_AP_SSID=ESP32-HID
ESP32_AP_PASSWORD=replace-with-a-strong-wifi-password
ESP32_STA_SSID=
ESP32_STA_PASSWORD=
ESP32_TELEMETRY_ROOT_CA=

WEB_PORT=3000
MCP_HOST=127.0.0.1
MCP_PORT=3333
MCP_AUTH_TOKEN=replace-with-a-separate-long-random-mcp-token
LOG_LEVEL=INFO
